
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["cypress", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },
  "files": [
    "e2e/file.cy.ts"
  ],
  "include": [
    "e2e/**/*.ts",
    "e2e/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
